                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#64D2FF"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="M10,2.5 L17,6 L10,9.5 L3,6 Z M10,11 L15.5,8.25 L17,9 L10,12.5 L3,9 L4.5,8.25 Z M10,14 L15.5,11.25 L17,12 L10,15.5 L3,12 L4.5,11.25 Z"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="1.13.2" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="Legacy Fabric" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
