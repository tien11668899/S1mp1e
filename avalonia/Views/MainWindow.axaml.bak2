                                        <TextBlock Text="版本庫" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="每個版本都套用液態玻璃介面" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="已安裝 4 / 12" FontSize="12.5"
                                               Foreground="{DynamicResource TextSub}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Classes="caption" Text="已安裝"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Classes="vrow" Margin="16,10" ColumnDefinitions="Auto,*,Auto">
