                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="caption" Text="可下載"/>
                            <Border Classes="card">
                                <StackPanel x:Name="DownloadList">
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#5E5CE6"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="M10,2.5 L17,6 L10,9.5 L3,6 Z M10,11 L15.5,8.25 L17,9 L10,12.5 L3,9 L4.5,8.25 Z M10,14 L15.5,11.25 L17,12 L10,15.5 L3,12 L4.5,11.25 Z"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="1.19.2" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="Fabric" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <Button Grid.Column="2" Classes="mini" Content="下載" Click="OnInstallVersion" Tag="1.19.2"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#5E5CE6"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="M10,2.5 L17,6 L10,9.5 L3,6 Z M10,11 L15.5,8.25 L17,9 L10,12.5 L3,9 L4.5,8.25 Z M10,14 L15.5,11.25 L17,12 L10,15.5 L3,12 L4.5,11.25 Z"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="1.18.2" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="Fabric" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <Button Grid.Column="2" Classes="mini" Content="下載" Click="OnInstallVersion" Tag="1.18.2"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#5E5CE6"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="M10,2.5 L17,6 L10,9.5 L3,6 Z M10,11 L15.5,8.25 L17,9 L10,12.5 L3,9 L4.5,8.25 Z M10,14 L15.5,11.25 L17,12 L10,15.5 L3,12 L4.5,11.25 Z"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="1.17.1" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="Fabric" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <Button Grid.Column="2" Classes="mini" Content="下載" Click="OnInstallVersion" Tag="1.17.1"/>
