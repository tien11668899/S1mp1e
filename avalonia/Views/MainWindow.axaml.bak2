                        </StackPanel>
                        <!-- ===== page: 帳號 ===== -->
                        <StackPanel x:Name="PageAccount" Spacing="20" IsVisible="False">
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#007AFF"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="F1 M10,2 A8,8 0 1 1 10.01,2 Z A8,8 0 1 1 10,18 Z M10,6.3 A2.4,2.4 0 1 1 10.01,6.3 Z A2.4,2.4 0 1 1 10,11.1 Z M5.5,14.5 C5.5,11.5 14.5,11.5 14.5,14.5 Z"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="登入 Microsoft 帳號" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="取得正版存檔、外觀與多人伺服器連線" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <Button Grid.Column="2" Classes="accent" Content="登入" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#34C759"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="F1 M10,2 L16.5,4.3 V9.7 C16.5,13.7 10,17.5 10,17.5 C10,17.5 3.5,13.7 3.5,9.7 V4.3 Z M10,8 A1.6,1.6 0 1 1 10.01,8 Z A1.6,1.6 0 1 1 10,11.2 Z M9.2,10.5 L10.8,10.5 L10.8,13.5 L9.2,13.5 Z"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="不會看到你的密碼" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="登入在 Microsoft 官方網頁完成，S1mp1e 只取得授權權杖" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="caption" Text="AZURE 應用程式"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#8E8E93"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="F1 M6,4.5 A3.5,3.5 0 1 1 6.01,4.5 Z A3.5,3.5 0 1 1 6,11.5 Z M6,6.5 A1.4,1.4 0 1 1 6.01,6.5 Z A1.4,1.4 0 1 1 6,9.3 Z M9.5,7 L18,7 L18,8.6 L16.3,8.6 L16.3,10.5 L14.9,10.5 L14.9,8.6 L13,8.6 L13,10 L11.6,10 L11.6,8.6 L9.5,8.6 Z"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Client ID" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="貼上你自己的 Azure 應用程式用戶端 ID" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <TextBox Grid.Column="2" Classes="field" PlaceholderText="未設定" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#5E5CE6"><Path Width="17" Height="17" Stretch="Uniform" Stroke="White" StrokeThickness="2.1" StrokeLineCap="Round" StrokeJoin="Round" Data="M7.3,7 A2.7,2.7 0 1 1 10.2,10 V11.8 M10.1,14.6 V14.8"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="如何建立 Azure App" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="免費 · 約 2 分鐘 · 公用用戶端應用程式" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <Path Grid.Column="2" Width="8" Height="12" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" Data="M1,1 L6,6 L1,11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="caption" Text="離線模式"/>
                            <Border Classes="card">
                                <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Classes="tile" Background="#FF9F0A"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="F1 M2.5,4.5 A1.2,1.2 0 0 1 3.7,3.3 L16.3,3.3 A1.2,1.2 0 0 1 17.5,4.5 L17.5,15.5 A1.2,1.2 0 0 1 16.3,16.7 L3.7,16.7 A1.2,1.2 0 0 1 2.5,15.5 Z M6.7,8 A1.7,1.7 0 1 1 6.71,8 Z A1.7,1.7 0 1 1 6.7,11.4 Z M4,14 C4,11.5 9.4,11.5 9.4,14 Z M11.2,7 L15.5,7 L15.5,8 L11.2,8 Z M11.2,9.5 L15.5,9.5 L15.5,10.5 L11.2,10.5 Z M11.2,12 L14.5,12 L14.5,13 L11.2,13 Z"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="離線名稱" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="不需登入即可進入單人與區域網路遊戲" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                    <TextBox Grid.Column="2" Classes="field" PlaceholderText="Player" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <!-- ===== page: 設定 ===== -->
                        <StackPanel x:Name="PageSettings" Spacing="20" IsVisible="False">
                            <TextBlock Classes="caption" Text="一般"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#007AFF"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="M3,6 L7.5,6 A0.5,0.5 0 0 1 7.85,6.15 L9.35,7.65 A0.5,0.5 0 0 0 9.7,7.8 L17,7.8 A1,1 0 0 1 18,8.8 L18,15 A1,1 0 0 1 17,16 L3,16 A1,1 0 0 1 2,15 L2,7 A1,1 0 0 1 3,6 Z"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="遊戲目錄" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="%APPDATA%\.minecraft" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <Button Grid.Column="2" Classes="mini" Content="選擇…" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#34C759"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="F1 M4,6 H16 V14 H4 Z M5.5,4.5 V6 H6.5 V4.5 Z M8.5,4.5 V6 H9.5 V4.5 Z M10.5,4.5 V6 H11.5 V4.5 Z M13.5,4.5 V6 H14.5 V4.5 Z M5.5,14 V15.5 H6.5 V14 Z M8.5,14 V15.5 H9.5 V14 Z M10.5,14 V15.5 H11.5 V14 Z M13.5,14 V15.5 H14.5 V14 Z M6.5,7.5 H13.5 V12.5 H6.5 Z"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="記憶體配置" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="配置給 Java 的最大堆積記憶體" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Slider x:Name="RamSlider" Width="140" Minimum="1" Maximum="16" Value="4"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding #RamSlider.Value, StringFormat='{}{0:0} GB'}"
                                                       FontSize="12.5" MinWidth="42"
                                                       Foreground="{DynamicResource TextSub}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#FF9F0A"><Path Width="17" Height="17" Stretch="Uniform" Stroke="White" StrokeThickness="1.5" StrokeJoin="Round" Data="M2.5,4.5 H17.5 V15.5 H2.5 Z M2.5,7.5 H17.5"/></Border>
                                        <TextBlock Grid.Column="1" Text="啟動遊戲後" FontSize="13" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                        <ctl:GlassSelect Grid.Column="2" SelectedIndex="0" VerticalAlignment="Center" FontSize="13"
                                                         Options="隱藏啟動器|保持開啟|關閉啟動器"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="caption" Text="外觀"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#5E5CE6"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="M10,3.5 A6.5,6.5 0 0 1 10,16.5 Z"/></Border>
                                        <TextBlock Grid.Column="1" Text="外觀" FontSize="13" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                        <ctl:GlassSelect x:Name="ThemeBox" Grid.Column="2" SelectedIndex="0" VerticalAlignment="Center" FontSize="13"
                                                         Options="自動|淺色|深色" SelectionChanged="OnThemeChanged"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#FF375F"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="F1 M14,3 A6,5 0 1 0 5.5,10 A1.2,1.2 0 0 1 6.5,11.5 A1.2,1.2 0 0 1 6.5,13.5 A2,2 0 0 0 8,17 C13,17 17,13.5 17,9 C17,6 15.5,4 14,3 Z M8,7 A0.9,0.9 0 1 1 8.01,7 Z M6.5,10 A0.9,0.9 0 1 1 6.51,10 Z M11.5,5.5 A0.9,0.9 0 1 1 11.51,5.5 Z M13.5,9 A0.9,0.9 0 1 1 13.51,9 Z"/></Border>
                                        <TextBlock Grid.Column="1" Text="強調色" FontSize="13" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                        <ctl:GlassSelect Grid.Column="2" SelectedIndex="0" VerticalAlignment="Center" FontSize="13"
                                                         Options="藍色|紫色|粉紅色|橙色|綠色|石墨"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#BF5AF2"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="M10,3 C10,3 5.5,9.5 5.5,12.5 A4.5,4.5 0 0 0 14.5,12.5 C14.5,9.5 10,3 10,3 Z"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="液態玻璃" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="在介面啟用即時折射玻璃效果" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <ctl:LiquidToggle Grid.Column="2" IsChecked="True" VerticalAlignment="Center" Margin="0,-6"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#8E8E93"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="M4,4 H12.5 V12.5 H4 Z M7.5,7.5 H16 V16 H7.5 Z"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="減少透明度" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="降低模糊與透明度，提升清晰度與效能" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <ctl:LiquidToggle x:Name="DemoToggle" Grid.Column="2" IsChecked="False" VerticalAlignment="Center" Margin="0,-6"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="caption" Text="關於"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#34C759"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="M10,2.5 L17,6 L10,9.5 L3,6 Z M10,11 L15.5,8.25 L17,9 L10,12.5 L3,9 L4.5,8.25 Z M10,14 L15.5,11.25 L17,12 L10,15.5 L3,12 L4.5,11.25 Z"/></Border>
                                        <TextBlock Grid.Column="1" Text="版本" FontSize="13" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="1.0.0" FontSize="12.5" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#5E5CE6"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="M10,3 L11.2,8 L16,9.2 L11.2,10.4 L10,15.2 L8.8,10.4 L4,9.2 L8.8,8 Z"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="液態玻璃" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="由即時折射 UI 引擎驅動，隨系統淺色與深色" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <Path Grid.Column="2" Width="8" Height="12" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" Data="M1,1 L6,6 L1,11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </Panel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= TITLE BAR (drag + traffic lights) ================= -->
        <Grid x:Name="TitleBarRoot" VerticalAlignment="Top" Height="40" Background="Transparent"
              PointerPressed="OnTitleBarPressed" lg:LiquidGlassBackdrop.IsExcludedFromCapture="True">
            <StackPanel x:Name="Traffic" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0"
                        Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border Classes="tl close" Tapped="OnClose">
                    <Panel>
                        <Image Source="avares://S1mp1e/Assets/tl_red_off.png"/>
                        <Image Classes="glyph" Source="avares://S1mp1e/Assets/tl_red_on.png"/>
                    </Panel>
                </Border>
                <Border Classes="tl min" Tapped="OnMinimize">
                    <Panel>
                        <Image Source="avares://S1mp1e/Assets/tl_yellow_off.png"/>
                        <Image Classes="glyph" Source="avares://S1mp1e/Assets/tl_yellow_on.png"/>
                    </Panel>
                </Border>
                <Border Classes="tl max" Tapped="OnMaximize">
                    <Panel>
                        <Image Source="avares://S1mp1e/Assets/tl_green_off.png"/>
                        <Image Classes="glyph" Source="avares://S1mp1e/Assets/tl_green_on.png"/>
                    </Panel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- floating primary action -->
        <Button x:Name="PlayButton" Classes="play"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24" Click="OnPlay"
                lg:LiquidGlassBackdrop.IsExcludedFromCapture="True">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="M5,3 L19,11 L5,19 Z"/>
                <TextBlock x:Name="PlayLabel" Text="Play" FontSize="19" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- shared liquid-glass pop-up MENU overlay (lives in the window's own tree, so the
             LiquidGlassSurface refracts the real window content behind it — a Popup can't) -->
        <Panel x:Name="OverlayHost" IsVisible="False" ZIndex="200"
               lg:LiquidGlassBackdrop.IsExcludedFromCapture="True">
            <Border x:Name="MenuDismiss" Background="Transparent" PointerPressed="OnMenuDismiss"/>
            <Canvas>
                <!-- glass is DECORATIVE only (IsHitTestVisible=False); rows sit ON TOP and take the
                     pointer, exactly like the selection pill — never hit-test through the refraction. -->
                <Panel x:Name="MenuRoot" Canvas.Left="0" Canvas.Top="0" Opacity="0"
                       RenderTransformOrigin="100%,0%">
                    <lg:LiquidGlassSurface x:Name="MenuGlass" CornerRadius="16" IsHitTestVisible="False"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                           RefractionHeight="11" RefractionAmount="20"
                                           ChromaticAberration="True" BlurRadius="8"
                                           Vibrancy="1.45" Brightness="0.03"
                                           TintColor="#1AFFFFFF" SurfaceColor="#26FFFFFF"
                                           HighlightEnabled="True" HighlightOpacity="0.5"
                                           HighlightWidth="0.5" HighlightBlurRadius="0.4" HighlightAngle="60"
                                           ShadowEnabled="True" ShadowRadius="22"
                                           ShadowColor="#45000000" ShadowOpacity="1"/>
                    <StackPanel x:Name="MenuItems" Margin="5"/>
                </Panel>
            </Canvas>
        </Panel>
    </Panel>
</Window>
