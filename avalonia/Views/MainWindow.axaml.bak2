<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lg="using:LiquidGlassAvaloniaUI"
        xmlns:ctl="using:S1mp1e.Controls"
        x:Class="S1mp1e.Views.MainWindow"
        Title="S1mp1e"
        Width="1040" Height="680"
        MinWidth="880" MinHeight="560"
        FontFamily="{DynamicResource AppFont}"
        Background="{DynamicResource DetailBg}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Window.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFont">avares://S1mp1e/Assets/Fonts/PingFangTC-Semibold.otf#PingFang TC</FontFamily>

            <!-- iOS-green ToggleSwitch (override Fluent's blue-on) -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn"            Color="#34C759"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#2FB84F"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"     Color="#28A745"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn"            Color="#34C759"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#2FB84F"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"     Color="#28A745"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"            Color="White"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed"     Color="White"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff"            Color="White"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="White"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed"     Color="White"/>

            <ResourceDictionary.ThemeDictionaries>
                <!-- macOS System Settings palette — light -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SidebarBg"  Color="#F0F2F5"/>
                    <SolidColorBrush x:Key="DetailBg"   Color="#FBFBFD"/>
                    <SolidColorBrush x:Key="CardBg"     Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#12000000"/>
                    <SolidColorBrush x:Key="Divider"    Color="#0F000000"/>
                    <SolidColorBrush x:Key="TextMain"   Color="#1D1D1F"/>
                    <SolidColorBrush x:Key="TextSub"    Color="#636366"/>
                    <SolidColorBrush x:Key="Accent"     Color="#007AFF"/>
                    <SolidColorBrush x:Key="FieldBg"    Color="#12000000"/>
                    <SolidColorBrush x:Key="ToggleOff"  Color="#E3E3E6"/>
                    <!-- liquid-glass pop-up menu -->
                    <SolidColorBrush x:Key="MenuBg"      Color="#FAFCFCFE"/>
                    <SolidColorBrush x:Key="MenuHover"   Color="#14000000"/>
                    <SolidColorBrush x:Key="MenuHi"      Color="#40FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOff"            Color="#E3E3E6"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#DADADD"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed"     Color="#D1D1D4"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff"            Color="#E3E3E6"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#DADADD"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed"     Color="#D1D1D4"/>
                </ResourceDictionary>
                <!-- macOS System Settings palette — dark -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SidebarBg"  Color="#1C1C1E"/>
                    <SolidColorBrush x:Key="DetailBg"   Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="CardBg"     Color="#2C2C2E"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#1AFFFFFF"/>
                    <SolidColorBrush x:Key="Divider"    Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="TextMain"   Color="#F5F5F7"/>
                    <SolidColorBrush x:Key="TextSub"    Color="#98989D"/>
                    <SolidColorBrush x:Key="Accent"     Color="#0A84FF"/>
                    <SolidColorBrush x:Key="FieldBg"    Color="#1FFFFFFF"/>
                    <SolidColorBrush x:Key="ToggleOff"  Color="#39393D"/>
                    <!-- liquid-glass pop-up menu -->
                    <SolidColorBrush x:Key="MenuBg"      Color="#F53A3A3C"/>
                    <SolidColorBrush x:Key="MenuHover"   Color="#24FFFFFF"/>
                    <SolidColorBrush x:Key="MenuHi"      Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOff"            Color="#39393D"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#434347"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed"     Color="#4A4A4F"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff"            Color="#39393D"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#434347"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed"     Color="#4A4A4F"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Kill Fluent's default accent selection/hover on ComboBox items; our custom
                 item template draws the ✓ and a subtle rounded hover pill instead. -->
            <SolidColorBrush x:Key="ComboBoxItemBackground"                  Color="Transparent"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver"       Color="Transparent"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed"           Color="Transparent"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected"          Color="Transparent"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed"   Color="Transparent"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ===================================================================
         SPACING SYSTEM — 8pt grid with 4pt half-steps: 4 / 8 / 12 / 16 / 20 / 24
         Derived by measuring real macOS System Settings (row height = 3.57x the
         body em => 48pt for 13pt body; divider inset symmetric on BOTH sides).

           4   micro          nav-row gap
           8   tight          section header -> its card
          12   inner          sidebar inset, icon -> label gap
          16   content inset  card horizontal padding, divider right inset
          20   group          card -> card, page title -> first card
          24   pane           detail pane padding, floating Play inset

         Derived values (do not drift):
           card row padding   16,10   -> 28pt icon + 20 = 48pt single-line row
           divider            56,0,16,0  (56 = 16 pad + 28 icon + 12 gap)
           icon tile          28x28 r7      card r12      nav row 40 r9
         =================================================================== -->
    <Window.Styles>
        <!-- Traffic lights (Border so we can glow via BoxShadow) -->
        <Style Selector="Border.tl">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.tl Image.glyph">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- when the pointer is over the cluster: reveal the glyph circle + colour glow -->
        <Style Selector="StackPanel#Traffic:pointerover Border.tl Image.glyph">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="StackPanel#Traffic:pointerover Border.close">
            <Setter Property="BoxShadow" Value="0 0 8 1 #B3FF5F57"/>
        </Style>
        <Style Selector="StackPanel#Traffic:pointerover Border.min">
            <Setter Property="BoxShadow" Value="0 0 8 1 #B3FEBC2E"/>
        </Style>
        <Style Selector="StackPanel#Traffic:pointerover Border.max">
            <Setter Property="BoxShadow" Value="0 0 8 1 #B328C840"/>
        </Style>

        <!-- round chevron buttons -->
        <Style Selector="Button.chev">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
        </Style>

        <!-- primary Play (floating capsule, bottom-right) -->
        <Style Selector="Button.play">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="27"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Padding" Value="26,0,30,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.play /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="CornerRadius" Value="27"/>
            <Setter Property="BoxShadow" Value="0 6 18 0 #38007AFF"/>
        </Style>
        <Style Selector="Button.play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A90FF"/>
        </Style>
        <Style Selector="Button.play:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0060DF"/>
        </Style>

        <!-- borderless search text field (sits inside the capsule) -->
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- small pill button (下載 / 選擇…) -->
        <Style Selector="Button.mini">
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.mini /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="13"/>
        </Style>
        <!-- accent-filled small button (登入) -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <!-- destructive text button (登出) -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
            <Setter Property="Foreground" Value="#FF453A"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.danger /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="13"/>
        </Style>
        <!-- inline editable value field (Client ID / 離線名稱) -->
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- settings-style grouped card + section caption -->
        <!-- Apple-style tinted icon tile: 28x28 squircle with a subtle top-edge highlight
             (like macOS Tahoe Settings icons). Background colour is set per-usage. -->
        <Style Selector="Border.tile">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        </Style>
        <!-- section header: 20 above (the page Spacing), 8 below — the -12 cancels the
             container's 20 so the header sits close to the card it labels, Apple-style. -->
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
            <Setter Property="Margin" Value="2,0,0,-12"/>
        </Style>

        <!-- liquid toggle (custom): green-on, white knob, springy liquid slide -->
        <Style Selector="ctl|LiquidToggle">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- oversized transparent host (64x52): the blob's max size (54x34) fits fully
                         inside it, so it can pop/grow WITHOUT overflowing anything = never clipped.
                         The 46x28 track sits centred in it. -->
                    <Panel Width="74" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center"
                           ClipToBounds="False">
                        <!-- flat oval track (48x24, narrower so the knob dominates) -->
                        <Border x:Name="Track" Width="48" Height="24" CornerRadius="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource ToggleOff}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.22"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <!-- knob: OVAL (28x20, wider, fills most of the track) -->
                        <Border x:Name="Knob" Width="28" Height="20" CornerRadius="16"
                                BorderThickness="1.2" BorderBrush="#CCFFFFFF"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                BoxShadow="0 2 7 0 #50000000">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="28%,0%" EndPoint="72%,100%">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#F2FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#DCFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ctl|LiquidToggle:checked /template/ Border#Track">
            <Setter Property="Background" Value="#34C759"/>
        </Style>

        <!-- macOS pop-up button: value + blue up/down chevron, borderless -->
        <Style Selector="ComboBox.popup">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="*,Auto">
                                <ContentControl Grid.Column="0"
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentTemplate="{TemplateBinding ItemTemplate}"
                                                Foreground="{DynamicResource Accent}"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                                Margin="0,0,8,0"/>
                                <Path Grid.Column="1" VerticalAlignment="Center" Stretch="None"
                                      Stroke="{DynamicResource Accent}" StrokeThickness="1.7"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M0,4 L4,0.5 L8,4 M0,7.5 L4,11 L8,7.5"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                               IsLightDismissEnabled="True"
                               Placement="BottomEdgeAlignedRight">
                            <!-- liquid-glass popover: super-rounded translucent panel, soft shadow, glass sheen -->
                            <Border x:Name="MenuRoot" Margin="0,6,6,12" MinWidth="124"
                                    Background="{DynamicResource MenuBg}" CornerRadius="16"
                                    BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                                    BoxShadow="0 10 30 0 #38000000"
                                    RenderTransformOrigin="88%,0%">
                                <Panel>
                                    <!-- faint top specular sheen -->
                                    <Border CornerRadius="16" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                <GradientStop Color="#2EFFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ItemsPresenter x:Name="PART_ItemsPresenter" Margin="5"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                </Panel>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ComboBox.popup:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
        </Style>

        <!-- pop-up MENU items: ✓ on the selected row, rounded hover pill, plain text colour -->
        <Style Selector="ComboBox.popup ComboBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Row" Background="Transparent" CornerRadius="9" Margin="3,1" Padding="8,7">
                        <Grid ColumnDefinitions="20,*">
                            <Path x:Name="Check" Grid.Column="0" Width="12" Height="10" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{DynamicResource TextMain}" StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M0,3.2 L3.4,6.6 L9,0" Opacity="0"/>
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ComboBox.popup ComboBoxItem:selected /template/ Path#Check">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- kill the default accent selection bar: the row itself is never coloured on select -->
        <Style Selector="ComboBox.popup ComboBoxItem:selected /template/ Border#Row">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.popup ComboBoxItem:selected:pointerover /template/ Border#Row">
            <Setter Property="Background" Value="{DynamicResource MenuHover}"/>
        </Style>
        <Style Selector="ComboBox.popup ComboBoxItem:pointerover /template/ Border#Row">
            <Setter Property="Background" Value="{DynamicResource MenuHover}"/>
        </Style>

        <!-- macOS pop-up button (custom): value + blue chevron, borderless, opens the glass menu -->
        <Style Selector="ctl|GlassSelect">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ctl|GlassSelect:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
        </Style>

        <!-- rows inside the liquid-glass menu: rounded hover pill -->
        <Style Selector="Border.menurow:pointerover">
            <Setter Property="Background" Value="{DynamicResource MenuHover}"/>
        </Style>
    </Window.Styles>

    <!-- window base -->
    <Panel Background="{DynamicResource DetailBg}">

        <Grid ColumnDefinitions="236,*">

            <!-- ================= SIDEBAR ================= -->
            <Panel Grid.Column="0" Background="{DynamicResource SidebarBg}">

                <!-- faint colour wash so the glass pill has something to refract -->
                <Canvas ClipToBounds="True" lg:LiquidGlassBackdrop.IsExcludedFromCapture="False">
                    <Ellipse Width="320" Height="320" Canvas.Left="-40" Canvas.Top="20">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#3E0A84FF" Offset="0"/>
                                <GradientStop Color="#000A84FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="220" Height="220" Canvas.Left="10" Canvas.Top="150">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#3030D0B0" Offset="0"/>
                                <GradientStop Color="#0030D0B0" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Canvas>

                <Grid Margin="12,48,12,12" RowDefinitions="Auto,Auto,*">

                    <!-- brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="9" Margin="8,0,0,16">
                        <Image Source="avares://S1mp1e/Assets/s1mp1e.png" Width="28" Height="28"/>
                        <TextBlock Text="S1mp1e" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- search -->
                    <Border Grid.Row="1" CornerRadius="16" Background="{DynamicResource FieldBg}"
                            Height="32" Margin="0,0,0,16">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
                            <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{DynamicResource TextSub}" StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M7,11.5 A4.5,4.5 0 1 0 7,2.5 A4.5,4.5 0 0 0 7,11.5 Z M10.2,10.2 L15,15"/>
                            <TextBox Grid.Column="1" x:Name="SearchBox" Classes="search" PlaceholderText="搜尋"
                                     Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"
                                     Margin="7,0,4,0" TextChanged="OnSearchChanged"/>
                            <Path Grid.Column="2" Width="12" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource TextSub}" StrokeThickness="1.5"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M9,2.6 C10.1,2.6 11,3.5 11,4.6 V8.4 C11,9.5 10.1,10.4 9,10.4 C7.9,10.4 7,9.5 7,8.4 V4.6 C7,3.5 7.9,2.6 9,2.6 Z M4.8,8 C4.8,10.3 6.7,12.2 9,12.2 C11.3,12.2 13.2,10.3 13.2,8 M9,12.2 V15 M6.5,15 H11.5"/>
                        </Grid>
                    </Border>

                    <!-- nav: pill layer behind rows -->
                    <Panel Grid.Row="2">
                        <Canvas x:Name="PillLayer">
                            <lg:LiquidGlassSurface x:Name="SelPill"
                                                   Width="212" Height="40" CornerRadius="9"
                                                   Canvas.Left="0" Canvas.Top="0"
                                                   RefractionHeight="12" RefractionAmount="22"
                                                   ChromaticAberration="True" BlurRadius="6"
                                                   Vibrancy="1.5" Brightness="0.02"
                                                   TintColor="#1E0A84FF" SurfaceColor="#20FFFFFF"
                                                   HighlightEnabled="True" HighlightOpacity="0.42"
                                                   HighlightWidth="0.4" HighlightBlurRadius="0.3" HighlightAngle="60"
                                                   ShadowEnabled="True" ShadowRadius="12"
                                                   ShadowColor="#26000000" ShadowOpacity="1"/>
                        </Canvas>

                        <StackPanel x:Name="NavRows" Spacing="4">
                            <!-- 開始遊戲 -->
                            <Border Classes="navrow" Height="40" CornerRadius="9" Background="Transparent"
                                    PointerPressed="OnNavRowPressed" Tag="0">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Accent}">
                                        <Path Width="15" Height="15" Stretch="Uniform" Fill="White"
                                              Data="M6,4 L15,10 L6,16 Z"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="開始遊戲" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="26.2 · Fabric" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- 版本 -->
                            <Border Classes="navrow" Height="40" CornerRadius="9" Background="Transparent"
                                    PointerPressed="OnNavRowPressed" Tag="1">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#30B0C7">
                                        <Path Width="15" Height="15" Stretch="Uniform" Fill="White"
                                              Data="M10,2.5 L17,6 L10,9.5 L3,6 Z M10,11 L15.5,8.25 L17,9 L10,12.5 L3,9 L4.5,8.25 Z M10,14 L15.5,11.25 L17,12 L10,15.5 L3,12 L4.5,11.25 Z"/>
                                    </Border>
                                    <TextBlock Text="版本" FontSize="13" Foreground="{DynamicResource TextMain}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- 帳號 -->
                            <Border Classes="navrow" Height="40" CornerRadius="9" Background="Transparent"
                                    PointerPressed="OnNavRowPressed" Tag="2">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#8E8E93">
                                        <Path Width="15" Height="15" Stretch="Uniform" Fill="White"
                                              Data="F1 M10,2 A8,8 0 1 1 10.01,2 Z A8,8 0 1 1 10,18 Z M10,6.3 A2.4,2.4 0 1 1 10.01,6.3 Z A2.4,2.4 0 1 1 10,11.1 Z M5.5,14.5 C5.5,11.5 14.5,11.5 14.5,14.5 Z"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="帳號" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="未登入" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- 設定 -->
                            <Border Classes="navrow" Height="40" CornerRadius="9" Background="Transparent"
                                    PointerPressed="OnNavRowPressed" Tag="3">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#8E8E93">
                                        <Path Width="15" Height="15" Stretch="Uniform" Fill="White"
                                              Data="F1 M10.92,3.87 L12.05,1.44 L14.60,2.50 L13.69,5.02 L14.98,6.31 L17.50,5.40 L18.56,7.95 L16.13,9.08 L16.13,10.92 L18.56,12.05 L17.50,14.60 L14.98,13.69 L13.69,14.98 L14.60,17.50 L12.05,18.56 L10.92,16.13 L9.08,16.13 L7.95,18.56 L5.40,17.50 L6.31,14.98 L5.02,13.69 L2.50,14.60 L1.44,12.05 L3.87,10.92 L3.87,9.08 L1.44,7.95 L2.50,5.40 L5.02,6.31 L6.31,5.02 L5.40,2.50 L7.95,1.44 L9.08,3.87 Z M10,7.5 A2.5,2.5 0 1 0 10,12.5 A2.5,2.5 0 0 0 10,7.5 Z"
/>
                                    </Border>
                                    <TextBlock Text="設定" FontSize="13" Foreground="{DynamicResource TextMain}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Panel>
                </Grid>

                <!-- hairline separating sidebar from detail -->
                <Rectangle Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                           Fill="{DynamicResource Divider}"/>
            </Panel>

            <!-- ================= DETAIL ================= -->
            <Border Grid.Column="1" Background="{DynamicResource DetailBg}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Padding="24,40,24,24">
                    <StackPanel Spacing="20">

                        <!-- header -->
                        <TextBlock x:Name="PageTitle" Text="開始遊戲" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMain}"/>

                        <Panel>
                        <!-- ===== page: 開始遊戲 ===== -->
                        <StackPanel x:Name="PageStart" Spacing="20">
                        <!-- version + loader card -->
                        <Border CornerRadius="12" BorderThickness="1"
                                BorderBrush="{DynamicResource CardBorder}" Background="{DynamicResource CardBg}">
                            <StackPanel>
                                <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Classes="tile" Background="#30B0C7">
                                        <Path Width="17" Height="17" Stretch="Uniform" Fill="White"
                                              Data="M10,2.5 L17,6 L10,9.5 L3,6 Z M10,11 L15.5,8.25 L17,9 L10,12.5 L3,9 L4.5,8.25 Z M10,14 L15.5,11.25 L17,12 L10,15.5 L3,12 L4.5,11.25 Z"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="版本" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="選擇要遊玩的 Minecraft 版本" FontSize="11"
                                                   Foreground="{DynamicResource TextSub}"/>
                                    </StackPanel>
                                    <ctl:GlassSelect x:Name="VersionBox" Grid.Column="2" SelectedIndex="0"
                                                     VerticalAlignment="Center" FontSize="13"
                                                     Options="26.2|1.21.1|1.20.1|1.16.5|1.8.9"/>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>

                                <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Classes="tile" Background="#34C759">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="White"
                                              Data="M10,2 L12,7 L17,7 L13,11 L15,17 L10,13 L5,17 L7,11 L3,7 L8,7 Z"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="載入器" FontSize="13"
                                               Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    <ctl:GlassSelect x:Name="LoaderBox" Grid.Column="2" SelectedIndex="0"
                                                     VerticalAlignment="Center" FontSize="13"
                                                     Options="Fabric|Forge"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <!-- ===== page: 版本 ===== -->
                        <StackPanel x:Name="PageVersions" Spacing="20" IsVisible="False">
                            <!-- overview -->
                            <Border Classes="card">
                                <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Classes="tile" Background="#30B0C7">
                                        <Path Width="17" Height="17" Stretch="Uniform" Fill="White"
                                              Data="M10,2.5 L17,6 L10,9.5 L3,6 Z M10,11 L15.5,8.25 L17,9 L10,12.5 L3,9 L4.5,8.25 Z M10,14 L15.5,11.25 L17,12 L10,15.5 L3,12 L4.5,11.25 Z"/>
                                    </Border>
