                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="26.2" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                            <TextBlock Text="Fabric · 最新版本" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <TextBlock Grid.Column="2" Text="✓ 已安裝" FontSize="12.5" Foreground="#34C759" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
