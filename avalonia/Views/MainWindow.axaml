<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lg="using:LiquidGlassAvaloniaUI"
        xmlns:ctl="using:S1mp1e.Controls"
        x:Class="S1mp1e.Views.MainWindow"
        Title="S1mp1e"
        Width="1040" Height="680"
        MinWidth="880" MinHeight="560"
        FontFamily="{DynamicResource AppFont}"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Blur,None"
        TransparencyBackgroundFallback="{DynamicResource DetailBg}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Window.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFont">avares://S1mp1e/Assets/Fonts/PingFangTC-Semibold.otf#PingFang TC</FontFamily>

            <!-- iOS-green ToggleSwitch (override Fluent's blue-on) -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn"            Color="#34C759"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#2FB84F"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"     Color="#28A745"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn"            Color="#34C759"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#2FB84F"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"     Color="#28A745"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"            Color="White"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed"     Color="White"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff"            Color="White"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="White"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed"     Color="White"/>

            <ResourceDictionary.ThemeDictionaries>
                <!-- macOS System Settings palette — light -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SidebarBg"  Color="#F0F2F5"/>
                    <Color x:Key="SidebarTint">#EDEDED</Color>
                    <SolidColorBrush x:Key="DetailBg"   Color="#FBFBFD"/>
                    <Color x:Key="DetailTint">#F5F5F7</Color>
                    <SolidColorBrush x:Key="CardBg"     Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#12000000"/>
                    <SolidColorBrush x:Key="Divider"    Color="#0F000000"/>
                    <SolidColorBrush x:Key="TextMain"   Color="#1D1D1F"/>
                    <SolidColorBrush x:Key="TextSub"    Color="#636366"/>
                    <SolidColorBrush x:Key="Accent"     Color="#007AFF"/>
                    <SolidColorBrush x:Key="FieldBg"    Color="#12000000"/>
                    <SolidColorBrush x:Key="ToggleOff"  Color="#E3E3E6"/>
                    <!-- liquid-glass pop-up menu -->
                    <SolidColorBrush x:Key="MenuBg"      Color="#FAFCFCFE"/>
                    <SolidColorBrush x:Key="MenuHover"   Color="#14000000"/>
                    <SolidColorBrush x:Key="MenuHi"      Color="#40FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOff"            Color="#E3E3E6"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#DADADD"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed"     Color="#D1D1D4"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff"            Color="#E3E3E6"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#DADADD"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed"     Color="#D1D1D4"/>
                </ResourceDictionary>
                <!-- macOS System Settings palette — dark -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SidebarBg"  Color="#1C1C1E"/>
                    <Color x:Key="SidebarTint">#1A1A1C</Color>
                    <SolidColorBrush x:Key="DetailBg"   Color="#1E1E1E"/>
                    <Color x:Key="DetailTint">#242426</Color>
                    <SolidColorBrush x:Key="CardBg"     Color="#2C2C2E"/>
                    <SolidColorBrush x:Key="CardBorder" Color="#1AFFFFFF"/>
                    <SolidColorBrush x:Key="Divider"    Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="TextMain"   Color="#F5F5F7"/>
                    <SolidColorBrush x:Key="TextSub"    Color="#98989D"/>
                    <SolidColorBrush x:Key="Accent"     Color="#0A84FF"/>
                    <SolidColorBrush x:Key="FieldBg"    Color="#1FFFFFFF"/>
                    <SolidColorBrush x:Key="ToggleOff"  Color="#39393D"/>
                    <!-- liquid-glass pop-up menu -->
                    <SolidColorBrush x:Key="MenuBg"      Color="#F53A3A3C"/>
                    <SolidColorBrush x:Key="MenuHover"   Color="#24FFFFFF"/>
                    <SolidColorBrush x:Key="MenuHi"      Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOff"            Color="#39393D"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#434347"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed"     Color="#4A4A4F"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff"            Color="#39393D"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#434347"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed"     Color="#4A4A4F"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Kill Fluent's default accent selection/hover on ComboBox items; our custom
                 item template draws the ✓ and a subtle rounded hover pill instead. -->
            <SolidColorBrush x:Key="ComboBoxItemBackground"                  Color="Transparent"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver"       Color="Transparent"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed"           Color="Transparent"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected"          Color="Transparent"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed"   Color="Transparent"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ===================================================================
         SPACING SYSTEM — 8pt grid with 4pt half-steps: 4 / 8 / 12 / 16 / 20 / 24
         Derived by measuring real macOS System Settings (row height = 3.57x the
         body em => 48pt for 13pt body; divider inset symmetric on BOTH sides).

           4   micro          nav-row gap
           8   tight          section header -> its card
          12   inner          sidebar inset, icon -> label gap
          16   content inset  card horizontal padding, divider right inset
          20   group          card -> card, page title -> first card
          24   pane           detail pane padding, floating Play inset

         Derived values (do not drift):
           card row padding   16,10   -> 28pt icon + 20 = 48pt single-line row
           divider            56,0,16,0  (56 = 16 pad + 28 icon + 12 gap)
           icon tile          28x28 r7      card r12      nav row 40 r9
         =================================================================== -->
    <Window.Styles>
        <!-- Traffic lights (Border so we can glow via BoxShadow).
             Default gives each light a transparent shadow with the SAME shape as the hover
             shadow so BoxShadowsTransition can interpolate its alpha (transitioning from an
             empty shadows collection to a single shadow pops instead of fading = "慢板拍"). -->
        <Style Selector="Border.tl">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.tl.close"><Setter Property="BoxShadow" Value="0 0 6 0 #00FF5F57"/></Style>
        <Style Selector="Border.tl.min"><Setter Property="BoxShadow"   Value="0 0 6 0 #00FEBC2E"/></Style>
        <Style Selector="Border.tl.max"><Setter Property="BoxShadow"   Value="0 0 6 0 #0028C840"/></Style>

        <Style Selector="Border.tl Image.glyph">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- when the pointer is over the cluster: reveal the glyph + a soft coloured glow
             (alpha 66 = ~40%, softer than the earlier B3 = 70%; radius/spread also toned down). -->
        <Style Selector="StackPanel#Traffic:pointerover Border.tl Image.glyph">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="StackPanel#Traffic:pointerover Border.close">
            <Setter Property="BoxShadow" Value="0 0 6 0 #66FF5F57"/>
        </Style>
        <Style Selector="StackPanel#Traffic:pointerover Border.min">
            <Setter Property="BoxShadow" Value="0 0 6 0 #66FEBC2E"/>
        </Style>
        <Style Selector="StackPanel#Traffic:pointerover Border.max">
            <Setter Property="BoxShadow" Value="0 0 6 0 #6628C840"/>
        </Style>

        <!-- round chevron buttons -->
        <Style Selector="Button.chev">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
        </Style>

        <!-- primary Play (floating capsule, bottom-right) -->
        <Style Selector="Button.play">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="27"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Padding" Value="26,0,30,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.play /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="CornerRadius" Value="27"/>
            <Setter Property="BoxShadow" Value="0 6 18 0 #38007AFF"/>
        </Style>
        <Style Selector="Button.play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A90FF"/>
        </Style>
        <Style Selector="Button.play:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0060DF"/>
        </Style>

        <!-- borderless search text field (sits inside the capsule) -->
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- small pill button (下載 / 選擇…) -->
        <Style Selector="Button.mini">
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.mini /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="13"/>
        </Style>
        <!-- accent-filled small button (登入) -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <!-- destructive text button (登出) -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
            <Setter Property="Foreground" Value="#FF453A"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.danger /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="13"/>
        </Style>
        <!-- inline editable value field (Client ID / 離線名稱) -->
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- settings-style grouped card + section caption -->
        <!-- Apple-style tinted icon tile: 28x28 squircle with a subtle top-edge highlight
             (like macOS Tahoe Settings icons). Background colour is set per-usage. -->
        <Style Selector="Border.tile">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        </Style>
        <!-- section header: 20 above (the page Spacing), 8 below — the -12 cancels the
             container's 20 so the header sits close to the card it labels, Apple-style. -->
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
            <Setter Property="Margin" Value="2,0,0,-12"/>
        </Style>

        <!-- liquid toggle (custom): green-on, white knob, springy liquid slide -->
        <Style Selector="ctl|LiquidToggle">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- oversized transparent host (64x52): the blob's max size (54x34) fits fully
                         inside it, so it can pop/grow WITHOUT overflowing anything = never clipped.
                         The 46x28 track sits centred in it. -->
                    <Panel Width="74" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center"
                           ClipToBounds="False">
                        <!-- flat oval track (48x24, narrower so the knob dominates) -->
                        <Border x:Name="Track" Width="48" Height="24" CornerRadius="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource ToggleOff}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.22"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <!-- knob: OVAL (28x20, wider, fills most of the track) -->
                        <Border x:Name="Knob" Width="28" Height="20" CornerRadius="16"
                                BorderThickness="1.2" BorderBrush="#CCFFFFFF"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                BoxShadow="0 2 7 0 #50000000">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="28%,0%" EndPoint="72%,100%">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#F2FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#DCFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ctl|LiquidToggle:checked /template/ Border#Track">
            <Setter Property="Background" Value="#34C759"/>
        </Style>

        <!-- macOS pop-up button: value + blue up/down chevron, borderless -->
        <Style Selector="ComboBox.popup">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="*,Auto">
                                <ContentControl Grid.Column="0"
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentTemplate="{TemplateBinding ItemTemplate}"
                                                Foreground="{DynamicResource Accent}"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                                Margin="0,0,8,0"/>
                                <Path Grid.Column="1" VerticalAlignment="Center" Stretch="None"
                                      Stroke="{DynamicResource Accent}" StrokeThickness="1.7"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M0,4 L4,0.5 L8,4 M0,7.5 L4,11 L8,7.5"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                               IsLightDismissEnabled="True"
                               Placement="BottomEdgeAlignedRight">
                            <!-- liquid-glass popover: super-rounded translucent panel, soft shadow, glass sheen -->
                            <Border x:Name="MenuRoot" Margin="0,6,6,12" MinWidth="124"
                                    Background="{DynamicResource MenuBg}" CornerRadius="16"
                                    BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                                    BoxShadow="0 10 30 0 #38000000"
                                    RenderTransformOrigin="88%,0%">
                                <Panel>
                                    <!-- faint top specular sheen -->
                                    <Border CornerRadius="16" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                <GradientStop Color="#2EFFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ItemsPresenter x:Name="PART_ItemsPresenter" Margin="5"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                </Panel>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ComboBox.popup:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
        </Style>

        <!-- pop-up MENU items: ✓ on the selected row, rounded hover pill, plain text colour -->
        <Style Selector="ComboBox.popup ComboBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Row" Background="Transparent" CornerRadius="9" Margin="3,1" Padding="8,7">
                        <Grid ColumnDefinitions="20,*">
                            <Path x:Name="Check" Grid.Column="0" Width="12" Height="10" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{DynamicResource TextMain}" StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M0,3.2 L3.4,6.6 L9,0" Opacity="0"/>
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ComboBox.popup ComboBoxItem:selected /template/ Path#Check">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- kill the default accent selection bar: the row itself is never coloured on select -->
        <Style Selector="ComboBox.popup ComboBoxItem:selected /template/ Border#Row">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.popup ComboBoxItem:selected:pointerover /template/ Border#Row">
            <Setter Property="Background" Value="{DynamicResource MenuHover}"/>
        </Style>
        <Style Selector="ComboBox.popup ComboBoxItem:pointerover /template/ Border#Row">
            <Setter Property="Background" Value="{DynamicResource MenuHover}"/>
        </Style>

        <!-- macOS pop-up button (custom): value + blue chevron, borderless, opens the glass menu -->
        <Style Selector="ctl|GlassSelect">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ctl|GlassSelect:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
        </Style>

        <!-- rows inside the liquid-glass menu: rounded hover pill -->
        <Style Selector="Border.menurow">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.menurow:pointerover">
            <Setter Property="Background" Value="{DynamicResource MenuHover}"/>
        </Style>

        <!-- Modrinth result row hover -->
        <Style Selector="Border.modrow">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.modrow:pointerover">
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
        </Style>

        <!-- Nav rows (sidebar) — animate the transparent → hover-tint fade -->
        <Style Selector="Border.navrow">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Buttons: bg + fg crossfade on hover / press so the accent-tint pop
             doesn't snap. Also covers the ContentPresenter (button subtree). -->
        <Style Selector="Button.mini, Button.accent, Button.danger, Button.play, Button.chev">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.mini /template/ ContentPresenter, Button.accent /template/ ContentPresenter, Button.danger /template/ ContentPresenter, Button.play /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- GlassSelect track fade -->
        <Style Selector="ctl|GlassSelect /template/ Border#Bg">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <!-- window base (transparent — the acrylic material behind is provided by the window's
         TransparencyLevelHint; the detail pane paints its own opaque background below). -->
    <Panel Background="Transparent">

        <Grid ColumnDefinitions="Auto,*">

            <!-- ================= SIDEBAR ================= -->
            <!-- No solid Background — an opaque bg here would cover the OS-level
                 acrylic that ExperimentalAcrylicBorder needs to render the frosted
                 look. Sidebar stays fully visible in both query and browse modes. -->
            <Border Grid.Column="0" x:Name="SidebarHost" Width="236" ClipToBounds="True">
            <Panel x:Name="SidebarInner" Background="Transparent">
                <!-- Real frosted material: the sidebar blurs whatever is behind the window.
                     Content (icons, labels, pill) then layers on TOP of this material.
                     x:Named so browse mode can fade JUST this layer — the sidebar rows
                     stay visible, only the frosted panel becomes flat DetailBg. -->
                <ExperimentalAcrylicBorder x:Name="SidebarAcrylic" IsHitTestVisible="False">
                    <ExperimentalAcrylicBorder.Material>
                        <ExperimentalAcrylicMaterial
                            BackgroundSource="Digger"
                            TintColor="{DynamicResource SidebarTint}"
                            TintOpacity="1"
                            MaterialOpacity="0.55"/>
                    </ExperimentalAcrylicBorder.Material>
                </ExperimentalAcrylicBorder>

<Grid x:Name="SidebarContent" Margin="12,48,12,12" RowDefinitions="Auto,Auto,*,Auto">

                    <!-- brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="9" Margin="8,0,0,16">
                        <Image Source="avares://S1mp1e/Assets/s1mp1e.png" Width="28" Height="28"/>
                        <TextBlock Text="S1mp1e" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- search -->
                    <Border Grid.Row="1" CornerRadius="16" Background="{DynamicResource FieldBg}"
                            Height="32" Margin="0,0,0,16">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
                            <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{DynamicResource TextSub}" StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M7,11.5 A4.5,4.5 0 1 0 7,2.5 A4.5,4.5 0 0 0 7,11.5 Z M10.2,10.2 L15,15"/>
                            <TextBox Grid.Column="1" x:Name="SearchBox" Classes="search" PlaceholderText="搜尋"
                                     Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"
                                     Margin="7,0,4,0" TextChanged="OnSearchChanged"/>
                            <Path Grid.Column="2" Width="12" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource TextSub}" StrokeThickness="1.5"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M9,2.6 C10.1,2.6 11,3.5 11,4.6 V8.4 C11,9.5 10.1,10.4 9,10.4 C7.9,10.4 7,9.5 7,8.4 V4.6 C7,3.5 7.9,2.6 9,2.6 Z M4.8,8 C4.8,10.3 6.7,12.2 9,12.2 C11.3,12.2 13.2,10.3 13.2,8 M9,12.2 V15 M6.5,15 H11.5"/>
                        </Grid>
                    </Border>

                    <!-- nav: pill layer behind rows.
                         ClipToBounds on both the Panel and the Canvas — otherwise the
                         LiquidGlassSurface's refraction/composite pass draws OUTSIDE its
                         bounds (turning into a "ghost 開始遊戲" above the pill when the
                         acrylic re-composites during dropdown open/close). -->
                    <Panel Grid.Row="2" ClipToBounds="True">
                        <Canvas x:Name="PillLayer" ClipToBounds="True">
                            <!-- Apple Liquid Glass: EDGE-ONLY optics. No body tint, no body
                                 blur. The visible effect is a rim refraction band (that bends
                                 what's underneath, giving the convex-lens look) plus a rim
                                 highlight — the interior stays clear and colourless. -->
                            <lg:LiquidGlassSurface x:Name="SelPill"
                                                   lg:LiquidGlassBackdrop.IsExcludedFromCapture="True"
                                                   Width="212" Height="40" CornerRadius="9"
                                                   Canvas.Left="0" Canvas.Top="0"
                                                   RefractionHeight="7" RefractionAmount="14"
                                                   ChromaticAberration="False" BlurRadius="0"
                                                   Vibrancy="1.0" Brightness="0"
                                                   TintColor="#00000000" SurfaceColor="#08FFFFFF"
                                                   HighlightEnabled="True" HighlightOpacity="0.55"
                                                   HighlightWidth="0.35" HighlightBlurRadius="0.25" HighlightAngle="60"
                                                   ShadowEnabled="True" ShadowRadius="12"
                                                   ShadowColor="#26000000" ShadowOpacity="1"/>
                        </Canvas>

                        <StackPanel x:Name="NavRows" Spacing="4">
                            <!-- 開始遊戲 -->
                            <Border Classes="navrow" Height="40" CornerRadius="9" Background="Transparent"
                                    PointerPressed="OnNavRowPressed" Tag="0">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Accent}">
                                        <Image Source="avares://S1mp1e/Assets/Icons/play.fill.png" Width="16" Height="16"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="開始遊戲" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock x:Name="StartNavSub" Text="26.2 · Fabric" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- 模組 -->
                            <Border Classes="navrow" Height="40" CornerRadius="9" Background="Transparent"
                                    PointerPressed="OnNavRowPressed" Tag="1">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#FF9F0A">
                                        <Image Source="avares://S1mp1e/Assets/Icons/cube.fill.png" Width="16" Height="16"/>
                                    </Border>
                                    <TextBlock Text="模組" FontSize="13" Foreground="{DynamicResource TextMain}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- 帳號 -->
                            <Border Classes="navrow" Height="40" CornerRadius="9" Background="Transparent"
                                    PointerPressed="OnNavRowPressed" Tag="2">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#8E8E93">
                                        <Image Source="avares://S1mp1e/Assets/Icons/person.crop.circle.fill.png" Width="16" Height="16"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="帳號" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock x:Name="NavAccountSub" Text="未登入" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- 設定 -->
                            <Border Classes="navrow" Height="40" CornerRadius="9" Background="Transparent"
                                    PointerPressed="OnNavRowPressed" Tag="3">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#8E8E93">
                                        <Image Source="avares://S1mp1e/Assets/Icons/gear.png" Width="16" Height="16"/>
                                    </Border>
                                    <TextBlock Text="設定" FontSize="13" Foreground="{DynamicResource TextMain}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Panel>

                    <!-- Account area at the sidebar bottom. TWO overlaid views:
                         (1) Logged-out CTA — a prominent blue + button pinned LEFT
                             that jumps to the 帳號 page.
                         (2) Full chip — avatar + name + small + on the right; the +
                             opens a 添加 / 登出 popup.
                         Crossfade on the two Opacities when login/logout happens. The
                         small + on the right is a separate control that fades in from
                         the left position of the CTA — visually the plus "flies over". -->
                    <Panel Grid.Row="3" Margin="0,8,0,0" Height="52" ClipToBounds="False">

                        <!-- (1) LOGGED-OUT: big blue + button, aligned LEFT -->
                        <Button x:Name="LoginCta" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Width="42" Height="42" Padding="0"
                                Background="{DynamicResource Accent}" BorderThickness="0"
                                CornerRadius="21" Click="OnLoginCtaClick"
                                ToolTip.Tip="登入 Microsoft 帳號">
                            <Image Source="avares://S1mp1e/Assets/Icons/plus.circle.fill.png"
                                   Width="24" Height="24"/>
                        </Button>

                        <!-- (2) LOGGED-IN: full chip -->
                        <Border x:Name="AccountChip" Opacity="0" IsVisible="False"
                                CornerRadius="9" Background="Transparent"
                                PointerPressed="OnAccountChipPressed" Cursor="Hand">
                            <Grid ColumnDefinitions="36,*,Auto" Margin="4,0">
                                <Ellipse x:Name="ChipAvatar" Grid.Column="0" Width="30" Height="30" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <ImageBrush Source="avares://S1mp1e/Assets/Icons/person.crop.circle.fill.png"
                                                    Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock x:Name="ChipName" Text="尚未登入" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock x:Name="ChipSub" Text="離線模式" FontSize="11"
                                               Foreground="{DynamicResource TextSub}"/>
                                </StackPanel>
                                <Button x:Name="ChipAdd" Grid.Column="2" Width="30" Height="30" Padding="0"
                                        Background="{DynamicResource FieldBg}" BorderThickness="0"
                                        CornerRadius="15" VerticalAlignment="Center" Click="OnChipPlusClick"
                                        ToolTip.Tip="添加或登出帳號">
                                    <Image Source="avares://S1mp1e/Assets/Icons/plus.circle.fill.png"
                                           Width="18" Height="18"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Panel>
                </Grid>

                <!-- hairline separating sidebar from detail -->
                <Rectangle Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                           Fill="{DynamicResource Divider}"/>
            </Panel>
            </Border>

            <!-- ================= DETAIL ================= -->
            <!-- Opaque like macOS System Settings' content pane. Only the sidebar is
                 vibrancy — keeping detail solid means the pop-up menu's LiquidGlassSurface
                 has real content to refract, and the sidebar pill stops re-capturing when
                 the right-side menu opens (a topLevel-transparency capture rerun). -->
            <Border Grid.Column="1" Background="{DynamicResource DetailBg}">
                <Grid>
                <ScrollViewer x:Name="DetailScroller"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                              Padding="24,40,24,24">
                    <StackPanel Spacing="20">

                        <!-- header -->
                        <TextBlock x:Name="PageTitle" Text="開始遊戲" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMain}"/>

                        <Panel>
                        <!-- ===== page: 開始遊戲 ===== -->
                        <StackPanel x:Name="PageStart" Spacing="20">
                        <!-- version + loader card -->
                        <Border CornerRadius="12" BorderThickness="1"
                                BorderBrush="{DynamicResource CardBorder}" Background="{DynamicResource CardBg}">
                            <StackPanel>
                                <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Classes="tile" Background="#30B0C7"><Image Source="avares://S1mp1e/Assets/Icons/square.stack.3d.up.fill.png" Width="18" Height="18"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="版本" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="選擇要遊玩的 Minecraft 版本" FontSize="11"
                                                   Foreground="{DynamicResource TextSub}"/>
                                    </StackPanel>
                                    <ctl:GlassSelect x:Name="VersionBox" Grid.Column="2" SelectedIndex="0"
                                                     VerticalAlignment="Center" FontSize="13"
                                                     Options="26.2|1.21.1|1.20.1|1.16.5|1.8.9"
                                                     SelectionChanged="OnVersionChanged"/>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>

                                <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Classes="tile" Background="#34C759">
                                        <Image Source="avares://S1mp1e/Assets/Icons/star.fill.png" Width="18" Height="18"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="載入器" FontSize="13"
                                               Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    <ctl:GlassSelect x:Name="LoaderBox" Grid.Column="2" SelectedIndex="0"
                                                     VerticalAlignment="Center" FontSize="13"
                                                     Options="Fabric|Forge"
                                                     SelectionChanged="OnLoaderChanged"/>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>

                                <!-- install status + on-demand download of the selected version -->
                                <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Classes="tile" Background="#FF9F0A">
                                        <TextBlock Text="↓" FontSize="17" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="安裝狀態" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock x:Name="InstallStatus" Text="檢查中…" FontSize="11"
                                                   Foreground="{DynamicResource TextSub}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" x:Name="InstallBtn" Classes="mini" Content="下載此版本"
                                            VerticalAlignment="Center" IsVisible="False"
                                            Click="OnInstallSelectedVersion"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <!-- ===== page: 模組 ===== -->
                        <StackPanel x:Name="PageMods" Spacing="20" IsVisible="False">
                            <!-- Single liquid-glass toggle: label shows the OPPOSITE mode
                                 (click "瀏覽模組" while querying → go to browse; click "查詢模組"
                                 while browsing → go to query). Same edge-only optics as the
                                 sidebar SelPill. -->
                            <lg:LiquidGlassSurface x:Name="ModModeToggle"
                                                   lg:LiquidGlassBackdrop.IsExcludedFromCapture="True"
                                                   HorizontalAlignment="Left"
                                                   Width="140" Height="34" CornerRadius="10"
                                                   RefractionHeight="7" RefractionAmount="14"
                                                   ChromaticAberration="False" BlurRadius="0"
                                                   Vibrancy="1.0" Brightness="0"
                                                   TintColor="#00000000" SurfaceColor="#12FFFFFF"
                                                   HighlightEnabled="True" HighlightOpacity="0.5"
                                                   HighlightWidth="0.35" HighlightBlurRadius="0.25" HighlightAngle="60"
                                                   ShadowEnabled="True" ShadowRadius="6"
                                                   ShadowColor="#22000000" ShadowOpacity="1"
                                                   PointerPressed="OnModModeToggle" Cursor="Hand">
                                <TextBlock x:Name="ModModeToggleLabel" Text="瀏覽模組"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMain}"/>
                            </lg:LiquidGlassSurface>
                            <!-- Search bar (~360 wide, pill) + sort dropdown on the right.
                                 ModSortBox hides in browse mode (local mods don't sort by heat).
                                 The row's Margin.Top animates smaller in browse mode so the
                                 search box "moves up" per the design brief. -->
                            <Grid x:Name="ModSearchRow" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <Border Grid.Column="0" HorizontalAlignment="Left"
                                        Width="360" Height="32" CornerRadius="16"
                                        Background="{DynamicResource FieldBg}">
                                    <Grid ColumnDefinitions="Auto,*" Margin="12,0">
                                        <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{DynamicResource TextSub}" StrokeThickness="1.6"
                                              StrokeLineCap="Round" StrokeJoin="Round"
                                              Data="M6.5,11 A4.5,4.5 0 1 0 6.5,2 A4.5,4.5 0 0 0 6.5,11 Z M9.8,9.8 L14,14"/>
                                        <TextBox Grid.Column="1" x:Name="ModSearchBox" Classes="search"
                                                 PlaceholderText="搜尋 Modrinth 模組"
                                                 Foreground="{DynamicResource TextMain}"
                                                 Margin="7,0,0,0"
                                                 TextChanged="OnModSearchTextChanged"/>
                                    </Grid>
                                </Border>
                                <ctl:GlassSelect Grid.Column="1" x:Name="ModSortBox"
                                                 Options="熱度|日期|相關性" SelectedIndex="0"
                                                 VerticalAlignment="Center" FontSize="13"
                                                 SelectionChanged="OnModSortChanged"/>
                            </Grid>

                            <!-- Two panes, crossfaded on toggle: ModrinthPane (query) and
                                 LocalBrowsePane (installed jars). No inner ScrollViewer /
                                 MaxHeight — the outer page ScrollViewer (line ~655) scrolls
                                 the whole thing, so more mods become visible as the window
                                 grows and a scrollbar only appears when needed. -->
                            <Panel x:Name="ModContentHost">
                                <StackPanel x:Name="ModrinthPane">
                                    <!-- Kept for status logic (Collapsed → zero-height) -->
                                    <TextBlock x:Name="ModStatus" IsVisible="False"/>
                                    <ItemsControl x:Name="ModList"/>
                                </StackPanel>
                                <StackPanel x:Name="LocalBrowsePane" IsVisible="False" Opacity="0">
                                    <TextBlock x:Name="LocalModStatus" IsVisible="False"/>
                                    <ItemsControl x:Name="LocalModList"/>
                                </StackPanel>
                            </Panel>
                        </StackPanel>
                        <!-- ===== page: 帳號 ===== -->
                        <StackPanel x:Name="PageAccount" Spacing="20" IsVisible="False">
                            <!-- Shown when signed in: skin head + name only + switch/登出 -->
                            <Border x:Name="SignedInCard" Classes="card" IsVisible="False">
                                <Grid Margin="16,14" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="10"
                                            ClipToBounds="True" Background="#22000000">
                                        <Image x:Name="PageSkinImage" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" x:Name="PageAccountName" Text="—"
                                               VerticalAlignment="Center"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMain}"/>
                                    <Button Grid.Column="2" Classes="mini" Content="切換帳號"
                                            VerticalAlignment="Center" Click="OnAccountSwitchClick"/>
                                    <Button Grid.Column="3" Classes="mini" Content="登出"
                                            VerticalAlignment="Center" Click="OnAccountLogoutClick"/>
                                </Grid>
                            </Border>

                            <!-- 皮膚 card (signed-in only) — full skin preview + 切換 -->
                            <Border x:Name="SkinCard" Classes="card" IsVisible="False">
                                <Grid Margin="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" Width="52" Height="90" CornerRadius="8"
                                            ClipToBounds="True" Background="#22000000">
                                        <Image x:Name="SkinBodyImage" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="皮膚" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="更換此帳號的 Minecraft 皮膚" FontSize="11"
                                                   Foreground="{DynamicResource TextSub}"/>
                                    </StackPanel>
                                    <Button x:Name="SkinChangeBtn" Grid.Column="2" Classes="mini"
                                            Content="切換" VerticalAlignment="Center"
                                            Click="OnSkinChangeClick"/>
                                </Grid>
                            </Border>
                            <!-- Login prompt: hidden once signed in -->
                            <Border x:Name="LoginPromptCard" Classes="card">
                                <StackPanel>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#007AFF"><Image Source="avares://S1mp1e/Assets/Icons/person.crop.circle.fill.png" Width="18" Height="18"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="登入 Microsoft 帳號" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="取得正版存檔、外觀與多人伺服器連線" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <Button x:Name="LoginBtn" Grid.Column="2" Classes="accent" Content="登入" VerticalAlignment="Center" Click="OnLogin"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#34C759"><Image Source="avares://S1mp1e/Assets/Icons/shield.fill.png" Width="18" Height="18"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="不會看到你的密碼" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="登入在 Microsoft 官方網頁完成，S1mp1e 只取得授權權杖" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Offline caption+card only visible when NOT signed in. -->
                            <TextBlock x:Name="OfflineCaption" Classes="caption" Text="離線模式"/>
                            <Border x:Name="OfflineCard" Classes="card">
                                <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Classes="tile" Background="#FF9F0A"><Image Source="avares://S1mp1e/Assets/Icons/person.crop.circle.fill.png" Width="18" Height="18"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="離線名稱" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="不需登入即可進入單人與區域網路遊戲" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                    <TextBox x:Name="OfflineNameBox" Grid.Column="2" Classes="field" PlaceholderText="Player" VerticalAlignment="Center" LostFocus="OnOfflineNameChanged"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <!-- ===== page: 設定 ===== -->
                        <StackPanel x:Name="PageSettings" Spacing="20" IsVisible="False">
                            <TextBlock Classes="caption" Text="一般"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#007AFF"><Image Source="avares://S1mp1e/Assets/Icons/folder.fill.png" Width="18" Height="18"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="遊戲目錄" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock x:Name="McPathLabel" Text="%APPDATA%\.minecraft" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <Button Grid.Column="2" Classes="mini" Content="選擇…" VerticalAlignment="Center" Click="OnPickMcDir"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#34C759"><Image Source="avares://S1mp1e/Assets/Icons/gauge.png" Width="18" Height="18"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="記憶體配置" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="配置給 Java 的最大堆積記憶體" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Slider x:Name="RamSlider" Width="140" Minimum="1" Maximum="16" Value="4"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                    ValueChanged="OnRamChanged"/>
                                            <TextBlock Text="{Binding #RamSlider.Value, StringFormat='{}{0:0} GB'}"
                                                       FontSize="12.5" MinWidth="42"
                                                       Foreground="{DynamicResource TextSub}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#FF9F0A"><Image Source="avares://S1mp1e/Assets/Icons/macwindow.png" Width="18" Height="18"/></Border>
                                        <TextBlock Grid.Column="1" Text="啟動遊戲後" FontSize="13" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                        <ctl:GlassSelect x:Name="AfterLaunchBox" Grid.Column="2" SelectedIndex="0" VerticalAlignment="Center" FontSize="13"
                                                         Options="隱藏啟動器|保持開啟|關閉啟動器" SelectionChanged="OnAfterLaunchChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="caption" Text="進階"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <!-- JVM 參數 -->
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Classes="tile" Background="#8E8E93" VerticalAlignment="Top">
                                            <TextBlock Text="⚙" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="JVM 參數" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                            <TextBox x:Name="JvmArgsBox" Classes="field" Margin="0,4,16,0"
                                                     Watermark="例：-XX:+UseG1GC -Dfile.encoding=UTF-8" LostFocus="OnJvmArgsChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <!-- 遊戲解析度 -->
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#30B0C7">
                                            <TextBlock Text="◱" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="遊戲解析度" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="留空或 0 = 使用遊戲預設" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBox x:Name="ResWidthBox" Classes="field" Width="66" Watermark="寬" LostFocus="OnResChanged"/>
                                            <TextBlock Text="×" VerticalAlignment="Center" Foreground="{DynamicResource TextSub}"/>
                                            <TextBox x:Name="ResHeightBox" Classes="field" Width="66" Watermark="高" LostFocus="OnResChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <!-- 自訂 Java 路徑 -->
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#FF9500">
                                            <TextBlock Text="☕" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="自訂 Java" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock x:Name="JavaPathLabel" Text="自動（依版本選擇）" FontSize="11" Foreground="{DynamicResource TextSub}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Classes="mini" Content="選擇…" Click="OnPickJava"/>
                                            <Button Classes="mini" Content="自動" Click="OnClearJava"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="caption" Text="外觀"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#5E5CE6"><Image Source="avares://S1mp1e/Assets/Icons/circle.righthalf.fill.png" Width="18" Height="18"/></Border>
                                        <TextBlock Grid.Column="1" Text="外觀" FontSize="13" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                        <ctl:GlassSelect x:Name="ThemeBox" Grid.Column="2" SelectedIndex="0" VerticalAlignment="Center" FontSize="13"
                                                         Options="自動|淺色|深色" SelectionChanged="OnThemeChanged"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#FF375F"><Image Source="avares://S1mp1e/Assets/Icons/paintbrush.fill.png" Width="18" Height="18"/></Border>
                                        <TextBlock Grid.Column="1" Text="強調色" FontSize="13" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                        <ctl:GlassSelect x:Name="AccentBox" Grid.Column="2" SelectedIndex="0" VerticalAlignment="Center" FontSize="13"
                                                         Options="藍色|紫色|粉紅色|橙色|綠色|石墨" SelectionChanged="OnAccentChanged"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#BF5AF2"><Image Source="avares://S1mp1e/Assets/Icons/drop.triangle.fill.png" Width="18" Height="18"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="液態玻璃" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="在介面啟用即時折射玻璃效果" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <ctl:LiquidToggle x:Name="GlassToggle" Grid.Column="2" IsChecked="True" VerticalAlignment="Center" Margin="0,-6" IsCheckedChanged="OnGlassToggleChanged"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#8E8E93"><Image Source="avares://S1mp1e/Assets/Icons/square.on.square.png" Width="18" Height="18"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="減少透明度" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="降低模糊與透明度，提升清晰度與效能" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <ctl:LiquidToggle x:Name="DemoToggle" Grid.Column="2" IsChecked="False" VerticalAlignment="Center" Margin="0,-6" IsCheckedChanged="OnReduceToggleChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="caption" Text="關於"/>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#34C759"><Image Source="avares://S1mp1e/Assets/Icons/square.stack.3d.up.fill.png" Width="18" Height="18"/></Border>
                                        <TextBlock Grid.Column="1" Text="版本" FontSize="13" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="1.0.0" FontSize="12.5" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="56,0,16,0"/>
                                    <Grid Margin="16,10" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="tile" Background="#5E5CE6"><Image Source="avares://S1mp1e/Assets/Icons/sparkles.png" Width="18" Height="18"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="液態玻璃" FontSize="13" Foreground="{DynamicResource TextMain}"/><TextBlock Text="由即時折射 UI 引擎驅動，隨系統淺色與深色" FontSize="11" Foreground="{DynamicResource TextSub}"/></StackPanel>
                                        <Path Grid.Column="2" Width="8" Height="12" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" Data="M1,1 L6,6 L1,11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </Panel>

                    </StackPanel>
                </ScrollViewer>
                <!-- Motion-blur overlay (anisotropic Skia blur, Y direction) -->
                <ctl:MotionBlurLayer x:Name="ScrollMotionBlur" IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= TITLE BAR (drag + traffic lights) ================= -->
        <Grid x:Name="TitleBarRoot" VerticalAlignment="Top" Height="40" Background="Transparent"
              PointerPressed="OnTitleBarPressed" lg:LiquidGlassBackdrop.IsExcludedFromCapture="True">
            <StackPanel x:Name="Traffic" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0"
                        Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border Classes="tl close" Tapped="OnClose">
                    <Panel>
                        <Image Source="avares://S1mp1e/Assets/tl_red_off.png"/>
                        <Image Classes="glyph" Source="avares://S1mp1e/Assets/tl_red_on.png"/>
                    </Panel>
                </Border>
                <Border Classes="tl min" Tapped="OnMinimize">
                    <Panel>
                        <Image Source="avares://S1mp1e/Assets/tl_yellow_off.png"/>
                        <Image Classes="glyph" Source="avares://S1mp1e/Assets/tl_yellow_on.png"/>
                    </Panel>
                </Border>
                <Border Classes="tl max" Tapped="OnMaximize">
                    <Panel>
                        <Image Source="avares://S1mp1e/Assets/tl_green_off.png"/>
                        <Image Classes="glyph" Source="avares://S1mp1e/Assets/tl_green_on.png"/>
                    </Panel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- floating primary action -->
        <Button x:Name="PlayButton" Classes="play"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24" Click="OnPlay"
                lg:LiquidGlassBackdrop.IsExcludedFromCapture="True">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="M5,3 L19,11 L5,19 Z"/>
                <TextBlock x:Name="PlayLabel" Text="Play" FontSize="19" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- shared liquid-glass pop-up MENU overlay (lives in the window's own tree, so the
             LiquidGlassSurface refracts the real window content behind it — a Popup can't) -->
        <Panel x:Name="OverlayHost" IsVisible="False" ZIndex="200"
               lg:LiquidGlassBackdrop.IsExcludedFromCapture="True">
            <Border x:Name="MenuDismiss" Background="Transparent" PointerPressed="OnMenuDismiss"/>
            <Canvas>
                <!-- glass is DECORATIVE only (IsHitTestVisible=False); rows sit ON TOP and take the
                     pointer, exactly like the selection pill — never hit-test through the refraction. -->
                <Panel x:Name="MenuRoot" Canvas.Left="0" Canvas.Top="0" Opacity="0"
                       RenderTransformOrigin="100%,0%">
                    <!-- Menu panel = same Apple Liquid Glass optics as the selection pill:
                         edge refraction + rim highlight, near-clear interior with just enough
                         surface tint to read as a panel over the acrylic settings pane. -->
                    <lg:LiquidGlassSurface x:Name="MenuGlass" CornerRadius="16" IsHitTestVisible="False"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                           RefractionHeight="10" RefractionAmount="26"
                                           ChromaticAberration="True" BlurRadius="0"
                                           Vibrancy="1.0" Brightness="0"
                                           TintColor="#00000000" SurfaceColor="#1CFFFFFF"
                                           HighlightEnabled="True" HighlightOpacity="0.55"
                                           HighlightWidth="0.35" HighlightBlurRadius="0.25" HighlightAngle="60"
                                           ShadowEnabled="True" ShadowRadius="22"
                                           ShadowColor="#45000000" ShadowOpacity="1"/>
                    <StackPanel x:Name="MenuItems" Margin="5"/>
                </Panel>
                <!-- Mod detail sheet — same glass optics as MenuRoot but wider and
                     contains a translated description. Shown by clicking a local
                     mod row; the OverlayHost's MenuDismiss backdrop closes it. -->
                <Panel x:Name="SheetRoot" Canvas.Left="0" Canvas.Top="0" Opacity="0"
                       IsVisible="False" ClipToBounds="True"
                       RenderTransformOrigin="50%,50%">
                    <lg:LiquidGlassSurface CornerRadius="20" IsHitTestVisible="False"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                           RefractionHeight="10" RefractionAmount="26"
                                           ChromaticAberration="True" BlurRadius="10"
                                           Vibrancy="1.0" Brightness="0"
                                           TintColor="#00000000" SurfaceColor="#28FFFFFF"
                                           HighlightEnabled="True" HighlightOpacity="0.55"
                                           HighlightWidth="0.35" HighlightBlurRadius="0.25" HighlightAngle="60"
                                           ShadowEnabled="True" ShadowRadius="24"
                                           ShadowColor="#55000000" ShadowOpacity="1"/>
                    <Grid Margin="18" RowDefinitions="Auto,Auto,*"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid Grid.Row="0" ColumnDefinitions="44,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                    ClipToBounds="True" Background="#22000000">
                                <Image x:Name="SheetIcon" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="SheetTitle" VerticalAlignment="Center"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Rectangle Grid.Row="1" Height="1" Margin="0,12" Fill="{DynamicResource Divider}"/>
                        <ScrollViewer Grid.Row="2" MaxHeight="260"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="SheetDesc" TextWrapping="Wrap" FontSize="13"
                                       LineHeight="20"
                                       Foreground="{DynamicResource TextMain}"/>
                        </ScrollViewer>
                    </Grid>
                </Panel>
                <!-- Skin gallery sheet — 尋找 皮膚 opens this. WrapPanel of skin
                     preview tiles; click a tile to apply that skin to the current
                     MSA account via SkinService. Same close semantics as SheetRoot. -->
                <Panel x:Name="SkinGalleryRoot" Canvas.Left="0" Canvas.Top="0" Opacity="0"
                       IsVisible="False" RenderTransformOrigin="50%,50%">
                    <lg:LiquidGlassSurface CornerRadius="20" IsHitTestVisible="False"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                           RefractionHeight="10" RefractionAmount="26"
                                           ChromaticAberration="True" BlurRadius="0"
                                           Vibrancy="1.0" Brightness="0"
                                           TintColor="#00000000" SurfaceColor="#1CFFFFFF"
                                           HighlightEnabled="True" HighlightOpacity="0.55"
                                           HighlightWidth="0.35" HighlightBlurRadius="0.25" HighlightAngle="60"
                                           ShadowEnabled="True" ShadowRadius="24"
                                           ShadowColor="#55000000" ShadowOpacity="1"/>
                    <Grid Margin="18" RowDefinitions="Auto,Auto,*,Auto">
                        <TextBlock Grid.Row="0" Text="尋找皮膚"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}"/>
                        <Rectangle Grid.Row="1" Height="1" Margin="0,10" Fill="{DynamicResource Divider}"/>
                        <ScrollViewer Grid.Row="2" MaxHeight="360"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SkinGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="3" x:Name="SkinGalleryStatus" Margin="0,10,0,0"
                                   FontSize="11" Foreground="{DynamicResource TextSub}"
                                   Text="載入中…"/>
                    </Grid>
                </Panel>
            </Canvas>
        </Panel>
    </Panel>
</Window>
