// Liquid Glass SKSL Shader (Lens refraction + dispersion)
// Adapted to Avalonia + SkiaSharp (SKRuntimeEffect).

uniform shader content;

uniform float2 size;                 // Control size (DIP in Avalonia coordinates)
uniform float4 cornerRadii;          // [topLeft, topRight, bottomRight, bottomLeft]
uniform float refractionHeight;      // Edge band thickness (DIP)
uniform float refractionAmount;      // Refraction strength (DIP)
uniform float depthEffect;           // 0..1
uniform float chromaticAberration;   // 0..1

// S1mp1e: Minecraft 26.2 glass.fsh edge model (see LiquidGlassSurface.SnellRefraction).
uniform float snell;                 // 0 = circle-map lens below, 1 = Snell edge model
uniform float snellThickness;        // refraction band from the edge (DIP)
uniform float snellIor;              // index of refraction (26.2: 1.4)
uniform float snellOffset;           // inward displacement at edge factor 1 (DIP)
uniform float snellDispersion;       // per-channel spread of the offset (26.2: 7 * 0.015 = 0.105)

float radiusAt(float2 centeredCoord, float4 radii) {
    if (centeredCoord.x >= 0.0) {
        if (centeredCoord.y < 0.0) return radii.y;
        else return radii.z;
    } else {
        if (centeredCoord.y < 0.0) return radii.x;
        else return radii.w;
    }
}

float sdRoundedRect(float2 coord, float2 halfSize, float radius) {
    float2 cornerCoord = abs(coord) - (halfSize - float2(radius));
    float outside = length(max(cornerCoord, 0.0)) - radius;
    float inside = min(max(cornerCoord.x, cornerCoord.y), 0.0);
    return outside + inside;
}

float2 gradSdRoundedRect(float2 coord, float2 halfSize, float radius) {
    float2 cornerCoord = abs(coord) - (halfSize - float2(radius));
    if (cornerCoord.x >= 0.0 || cornerCoord.y >= 0.0) {
        return sign(coord) * normalize(max(cornerCoord, 0.0));
    } else {
        float gradX = step(cornerCoord.y, cornerCoord.x);
        return sign(coord) * float2(gradX, 1.0 - gradX);
    }
}


// S1mp1e: continuous-curvature ("squircle") corner — a superellipse |x/a|^n + |y/a|^n = 1 (n = 2 is the circular corner;
// iOS's continuous corner of radius R fits n ≈ 2.8 with a ≈ 1.31 R). Shared by the lens SDF and the highlight normal.
uniform float cornerExponent;        // <= 2: plain rounded rect; > 2: squircle with this exponent

float lengthP(float2 v, float n) {
    float2 p = pow(max(v, float2(0.0)), float2(n));
    return pow(p.x + p.y, 1.0 / n);
}

// signed distance to the squircle-cornered box (first-order Euclidean normalisation near the edge)
float sdSquircleRect(float2 coord, float2 halfSize, float a, float n) {
    float2 c = abs(coord) - (halfSize - float2(a));
    float2 q = max(c, float2(0.0));
    float f = lengthP(q, n) - a;                       // p-norm distance (exact on the axes)
    float s = pow(q.x, n) + pow(q.y, n);
    float2 g = pow(q, float2(n - 1.0)) * pow(max(s, 1e-6), 1.0 / n - 1.0);
    float gl = max(length(g), 1e-4);
    float outside = (s > 1e-6) ? f / gl : f;
    float inside = min(max(c.x, c.y), 0.0);
    return outside + inside;
}

float2 gradSdSquircleRect(float2 coord, float2 halfSize, float a, float n) {
    float2 c = abs(coord) - (halfSize - float2(a));
    if (c.x >= 0.0 || c.y >= 0.0) {
        float2 q = max(c, float2(0.0));
        float s = pow(q.x, n) + pow(q.y, n);
        if (s <= 1e-6) return float2(0.0);
        float2 g = pow(q, float2(n - 1.0)) * pow(s, 1.0 / n - 1.0);
        return sign(coord) * normalize(g);
    } else {
        float gx = step(c.y, c.x);
        return sign(coord) * float2(gx, 1.0 - gx);
    }
}

float circleMap(float x) {
    x = clamp(x, 0.0, 1.0);
    return 1.0 - sqrt(1.0 - x * x);
}

half4 sampleDispersed(float2 refractedCoord, float2 dispersedCoord) {
    half4 color = half4(0.0);

    half4 red = content.eval(refractedCoord + dispersedCoord);
    color.r += red.r / 3.5;
    color.a += red.a / 7.0;

    half4 orange = content.eval(refractedCoord + dispersedCoord * (2.0 / 3.0));
    color.r += orange.r / 3.5;
    color.g += orange.g / 7.0;
    color.a += orange.a / 7.0;

    half4 yellow = content.eval(refractedCoord + dispersedCoord * (1.0 / 3.0));
    color.r += yellow.r / 3.5;
    color.g += yellow.g / 3.5;
    color.a += yellow.a / 7.0;

    half4 green = content.eval(refractedCoord);
    color.g += green.g / 3.5;
    color.a += green.a / 7.0;

    half4 cyan = content.eval(refractedCoord - dispersedCoord * (1.0 / 3.0));
    color.g += cyan.g / 3.5;
    color.b += cyan.b / 3.0;
    color.a += cyan.a / 7.0;

    half4 blue = content.eval(refractedCoord - dispersedCoord * (2.0 / 3.0));
    color.b += blue.b / 3.0;
    color.a += blue.a / 7.0;

    half4 purple = content.eval(refractedCoord - dispersedCoord);
    color.r += purple.r / 7.0;
    color.b += purple.b / 3.0;
    color.a += purple.a / 7.0;

    return color;
}

half4 main(float2 coord) {
    float2 halfSize = size * 0.5;
    float2 centeredCoord = coord - halfSize;
    float radius = radiusAt(centeredCoord, cornerRadii);

    bool squircle = cornerExponent > 2.001;
    float sd = squircle ? sdSquircleRect(centeredCoord, halfSize, radius, cornerExponent)
                        : sdRoundedRect(centeredCoord, halfSize, radius);

    if (snell > 0.5) {
        // Port of LiquidGlass26 glass.fsh: xR = 1 - depth/band, thetaI = asin(xR^2), thetaT = asin(sin(thetaI)/IOR),
        // edgeFactor = -tan(thetaT - thetaI) (~0.98 at the very edge, ~0.34 at 10% depth, ~0.07 at half the band),
        // and the backdrop is sampled INWARD along the SDF normal: offset = -normal * edgeFactor * scale.
        float band = max(snellThickness, 0.001);
        float depth = max(-sd, 0.0);
        if (depth >= band) {
            return content.eval(coord);
        }
        float xR = clamp(1.0 - depth / band, 0.0, 1.0);
        float thetaI = asin(xR * xR);
        float thetaT = asin(clamp(sin(thetaI) / snellIor, -1.0, 1.0));
        float edgeFactor = -tan(thetaT - thetaI);
        float gradR = min(radius * 1.5, min(halfSize.x, halfSize.y));
        float2 n = squircle ? gradSdSquircleRect(centeredCoord, halfSize, gradR, cornerExponent)
                            : gradSdRoundedRect(centeredCoord, halfSize, gradR);
        float2 off = -n * edgeFactor * snellOffset;
        if (snellDispersion <= 0.0005) {
            return content.eval(coord + off);
        }
        half4 cR = content.eval(coord + off * (1.0 + snellDispersion));
        half4 cG = content.eval(coord + off);
        half4 cB = content.eval(coord + off * (1.0 - snellDispersion));
        return half4(cR.r, cG.g, cB.b, cG.a);
    }

    float h = max(refractionHeight, 0.001);

    // Flat center region: no refraction.
    if (-sd >= h) {
        return content.eval(coord);
    }

    // Only care about inside. Outside will be clipped in C#.
    sd = min(sd, 0.0);

    float d = circleMap(1.0 - (-sd / h)) * refractionAmount;
    float gradRadius = min(radius * 1.5, min(halfSize.x, halfSize.y));
    float2 grad = squircle ? gradSdSquircleRect(centeredCoord, halfSize, gradRadius, cornerExponent)
                           : gradSdRoundedRect(centeredCoord, halfSize, gradRadius);
    grad = normalize(grad + depthEffect * normalize(centeredCoord));

    float2 refractedCoord = coord + d * grad;

    half4 result;
    if (chromaticAberration <= 0.001) {
        result = content.eval(refractedCoord);
    } else {
        float denom = max(halfSize.x * halfSize.y, 0.001);
        float dispersionIntensity = chromaticAberration * ((centeredCoord.x * centeredCoord.y) / denom);
        float2 dispersedCoord = d * grad * dispersionIntensity;
        result = sampleDispersed(refractedCoord, dispersedCoord);
    }
    return result;
}
